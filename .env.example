# Free-tier keys only. Never commit real keys.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

GROQ_BASE_URL=https://api.groq.com/openai/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional route overrides. Format: provider:model, comma-separated fallback chain.
# Split each entry on the FIRST colon only (model slugs can contain colons).
# Free model names change often. Verify each in its provider catalogue before use.
ROUTE_EXTRACTOR=groq:qwen/qwen3.8-27b,gemini:gemini-3.5-flash-lite,openrouter:openrouter/free
ROUTE_TECHNICAL=gemini:gemini-3.5-flash-lite,groq:openai/gpt-oss-120b,openrouter:google/gemma-4-31b-it:free
ROUTE_MANAGER=groq:openai/gpt-oss-120b,openrouter:openrouter/free,gemini:gemini-3.5-flash-lite
ROUTE_HR=openrouter:openrouter/free,gemini:gemini-3.5-flash-lite,groq:qwen/qwen3.8-27b
ROUTE_MODERATOR=gemini:gemini-3.5-flash-lite,groq:openai/gpt-oss-120b,openrouter:openrouter/free
ROUTE_CHAIR=groq:openai/gpt-oss-120b,gemini:gemini-3.5-flash-lite,openrouter:openrouter/free

MAX_CONCURRENCY=1
DATABASE_URL=sqlite:///./talentcouncil.db
FRONTEND_ORIGIN=http://localhost:3000
MOCK_LLM=1
